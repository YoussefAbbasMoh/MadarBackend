# Copy to ".env" in this folder and fill in real values.
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (macOS / Linux)
# Never commit ".env" with secrets.

# --- Core (required for a normal dev run) ---
NODE_ENV=development
PORT=2000

# PostgreSQL (Prisma + Sequelize). URL-encode reserved chars in the password (e.g. $ → %24).
DATABASE_URL="postgresql://postgres:fast227CARS%24@185.190.142.44:5432/madardb"

# MongoDB (legacy — not used once API runs on PostgreSQL only)
# MONGO_URI=mongodb+srv://...
# MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/lms?retryWrites=true&w=majority

REDIS_URL=redis://127.0.0.1:6379

# --- Auth (JWT) ---
# Option A: symmetric signing (simplest for local dev)
JWT_SECRET=change-this-to-a-long-random-string-in-production


VCONNECT_API_URL=https://v.cloudapi.vconnct.me
VCONNECT_PROJECT_ID=1b2ec6e7-b8e8-4317-9b6d-0ea2aa691ee5
VCONNECT_API_KEY=861265d6-f148-478f-92d7-ac805e3130cc
VCONNECT_SECRET_KEY=534976d4-95c0-4f3a-b97e-47234c51ef43

# Option B: RS256 — set both PEM blocks (use literal \n for newlines in a single line, or real multiline in .env)
# JWT_RSA_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# JWT_RSA_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----

JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Seed staff (see src/init/ensureSeedStaff.js) — dev defaults if AUTO_SEED_STAFF is on
# SEED_ACCOUNT_PASSWORD=admin1234
# AUTO_SEED_STAFF=1
# FORCE_SEED_STAFF_PASSWORD_SYNC=1

# --- HTTP / workers ---
# TRUST_PROXY=1
# Set to 0 if Node is exposed directly with no reverse proxy
# TRUST_PROXY=0

# BullMQ inline workers in the API process (set 0 to disable)
# ENABLE_INLINE_WORKERS=1

# --- Optional integrations ---
# PUBLIC_WEB_URL=http://localhost:4000

# Cloudinary (media)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# BeOne SMS / OTP
# BEONE_API_KEY=
# BEONE_SENDER=

# V-Connect (live sessions)
# VCONNECT_API_URL=
# VCONNECT_API_KEY=

# Paymob
# PAYMOB_API_KEY=
# PAYMOB_INTEGRATION_ID=
# PAYMOB_IFRAME_ID=
# PAYMOB_HMAC_SECRET=

# Contabo S3-compatible storage
# CONTABO_ENDPOINT=
# CONTABO_ACCESS_KEY=
# CONTABO_SECRET_KEY=
# CONTABO_BUCKET=
# CONTABO_REGION=

# Agent / device security
# AGENT_HMAC_SECRET=dev-agent-hmac
