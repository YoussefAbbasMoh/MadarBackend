# Copy to ".env" in this folder and fill in real values.
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (macOS / Linux)
# Never commit ".env" with secrets.

# --- Core (required for a normal dev run) ---
NODE_ENV=development
PORT=2000

# PostgreSQL (required) — Sequelize uses this URL. Schema matches prisma/migrations (run migrations with Prisma CLI or apply SQL manually).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/lms?schema=public

# MUDAR multi-tenant: apex host used to parse `{slug}.<domain>` (no https://). Dev often uses `localhost` + header `X-Mudar-Tenant-Slug`.
MUDAR_BASE_DOMAIN=localhost

REDIS_URL=redis://127.0.0.1:6379

# --- Auth (JWT) ---
# Option A: symmetric signing (simplest for local dev)
JWT_SECRET=change-this-to-a-long-random-string-in-production

# Option B: RS256 — set both PEM blocks (use literal \n for newlines in a single line, or real multiline in .env)
# JWT_RSA_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# JWT_RSA_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----

JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Seed users on API startup (see src/init/ensureSeedStaff.js)
# When AUTO_SEED_STAFF is on (default in development): if there is no super_admin / instructor, they are created.
# If the user collection was completely empty at boot, one demo student (OTP) is added too.
# If the seed instructor still owns zero courses, the API seeds 10 sample courses (lessons + materials + quizzes) and 10 OTP students (one learner per course for split test rosters).
# SEED_ACCOUNT_PASSWORD=admin1234
# AUTO_SEED_STAFF=0
# AUTO_SEED_STAFF=1
# FORCE_SEED_STAFF_PASSWORD_SYNC=1

# --- HTTP / workers ---
# TRUST_PROXY=1
# Set to 0 if Node is exposed directly with no reverse proxy
# TRUST_PROXY=0

# BullMQ inline workers in the API process (set 0 to disable)
# ENABLE_INLINE_WORKERS=1

# --- Optional integrations ---
# PUBLIC_WEB_URL=http://localhost:4000

# Cloudinary (media)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# BeOne SMS / OTP
# BEONE_API_KEY=
# BEONE_SENDER=

# V-Connect / VCloud v4 (live sessions) — https://guide.vconnct.com/docs/v4
# Must include /api/v4 — requests go to {VCONNECT_API_URL}/rooms/…
# If you set only https://v.cloudapi.vconnct.me the server auto-appends /api/v4.
# VCONNECT_API_URL=https://v.cloudapi.vconnct.me/api/v4
# VCONNECT_PROJECT_ID=
# VCONNECT_API_KEY=
# VCONNECT_SECRET_KEY=

# Paymob
# PAYMOB_API_KEY=
# PAYMOB_INTEGRATION_ID=
# PAYMOB_IFRAME_ID=
# PAYMOB_HMAC_SECRET=

# Contabo S3-compatible storage
# CONTABO_ENDPOINT=
# CONTABO_ACCESS_KEY=
# CONTABO_SECRET_KEY=
# CONTABO_BUCKET=
# CONTABO_REGION=

# Agent / device security
# AGENT_HMAC_SECRET=dev-agent-hmac
